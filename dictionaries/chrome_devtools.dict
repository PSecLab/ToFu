# Chrome DevTools MCP Server Fuzzing Dictionary
# Dominant selectors, URLs, JS expressions, key codes, and page operations

kw_click="click"
kw_navigate="navigate_page"
kw_evaluate="evaluate_script"
kw_selector="body"
kw_button_selector="button"
kw_input_selector="input"
kw_div_selector="div"
kw_id_selector="#main"
kw_class_selector=".container"

url_local="http://localhost:8080"
url_data="data:text/html,<html><body><h1>Test Page</h1></body></html>"
url_file="file:///tmp/sample.html"

js_alert="alert(1)"
js_eval="console.log('fuzz')"
js_infinite_loop="while(true){}"
js_error="throw new Error('fuzz_crash')"
js_dom_access="document.cookie"

key_enter="Enter"
key_tab="Tab"
key_escape="Escape"
key_backspace="Backspace"

str_sql_injection="' OR '1'='1"
str_path_traversal="../../../etc/passwd"
str_script_injection="<script>alert(1)</script>"
