# MarkItDown MCP Fuzzing Dictionary
# File extensions, MIME types, schemes, and markup content

ext_pdf=".pdf"
ext_docx=".docx"
ext_xlsx=".xlsx"
ext_pptx=".pptx"
ext_html=".html"
ext_csv=".csv"
ext_json=".json"

mime_pdf="application/pdf"
mime_docx="application/vnd.openxmlformats-officedocument.wordprocessingml.document"
mime_xlsx="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
mime_html="text/html"

scheme_file="file://"
scheme_http="http://"
scheme_https="https://"

str_path_traversal="../../../etc/passwd"
str_null_byte="document\x00.pdf"
str_malformed_url="http://invalid.domain.fuzz:99999/test"
