def _ps_snapshot() -> dict:
    """pid -> (ppid, comm) for every process, portable across Linux and macOS.

    The code this replaces read os.listdir("/proc") directly. THERE IS NO /proc
    ON macOS -- the eval machine. Every read raised FileNotFoundError into a
    bare `except Exception: pass`, so before_pids and after_pids were always
    empty, leaked_pids was always empty, and check_process_and_fd_leaks /
    check_terminal_dos_and_leak could NEVER fire on the platform the campaign
    actually runs on. Silently: no error, no warning, just a sanitizer family
    that reports nothing forever. Verified 2026-09-10:
        os.listdir('/proc') -> FileNotFoundError [Errno 2] on Darwin-arm64
    """
    if os.path.isdir("/proc"):
        out = {}
        for x in os.listdir("/proc"):
            if not x.isdigit():
                continue
            try:
                with open(f"/proc/{x}/stat") as f:
                    stat = f.read()
                # comm sits in parens and may itself contain spaces or parens,
                # so split on the LAST ')'.
                r = stat.rindex(")")
                out[int(x)] = (int(stat[r + 2:].split()[1]), stat[stat.index("(") + 1:r])
            except Exception:
                continue
        return out
    # macOS / BSD
    try:
        res = subprocess.run(["ps", "-Ao", "pid=,ppid=,comm="],
                             capture_output=True, timeout=10)
        out = {}
        for line in res.stdout.decode(errors="ignore").splitlines():
            parts = line.split(None, 2)
            if len(parts) < 2:
                continue
            try:
                out[int(parts[0])] = (int(parts[1]),
                                      (parts[2].strip() if len(parts) > 2 else ""))
            except ValueError:
                continue
        return out
    except Exception:
        return {}


class MCPDifferentialFuzzer:
    def __init__(self, command: str, args: list, target_tool: str, api_key: str, 
                 corpus_dir: str = "./fuzz_corpus", override_rules: dict = None, 
                 file_backed_params: dict = None, config: FuzzerConfig = None, 
                 reporter = None, metadata_provider = None, runner_factory = None,
                 predefined_seeds: list = None, dict_file: str = None):
        self.command = command
        self.args = args
        self.target_tool = target_tool
        self.corpus_dir = corpus_dir
        self.llm = LLMHandler(api_key=api_key)
        self.override_rules = override_rules or {}
        self.file_backed_params = file_backed_params or {}
        self.config = config or FuzzerConfig()
        self.predefined_seeds = predefined_seeds or []
        self.dict_file = dict_file
        self.target_tool_desc = ""
        
        # Inject metadata provider
        if metadata_provider is None:
            from .client import MCPInspector
            self.inspector = MCPInspector(command=command, args=args)
        else:
            self.inspector = metadata_provider

        # Inject runner factory
        if runner_factory is None:
            self.runner_factory = self._default_runner_factory
        else:
            self.runner_factory = runner_factory

        if reporter is None:
            # The Mongo sink was unconditional while FuzzerConfig.export_mongo
            # (default False) was ignored. With no mongod running, EVERY finding
            # cost a 2s serverSelectionTimeoutMS: the 2026-09-10 appium run spent
            # ~124s of its 540.4s wall clock on 62 connection-refused retries,
            # which silently corrupts the per-run time budget the campaign
            # accounts in. Console only unless the config asks for Mongo.
            # This changes where findings are LOGGED, never what is found.
            sinks = [ConsoleVulnerabilityReporter()]
            if getattr(self.config, "export_mongo", False):
                sinks.append(MongoVulnerabilityReporter())
            self.reporter = CompositeVulnerabilityReporter(sinks)
        else:
            self.reporter = reporter
            
        self.current_runner = None
        self.current_schema = None
        self.selected_sanitizer_names = []
        self.selected_sanitizer_rules = {}
        self.silent_bug_found = False
        self.target_tool_name = ""
        self.exec_count = 0
        # EXECUTABILITY ACCOUNTING. A tool whose every execution returns
        # isError/JSON-RPC-error never really ran, so no sanitizer can fire and
        # the run reports a healthy "0 findings". Measured 2026-09-10 on
        # api7/apisix-mcp::delete_resource: every input returned
        #   "Status: undefined\nMessage: connect ECONNREFUSED 127.0.0.1:9180"
        # because the tool is an Admin-API client and no APISIX is running. All
        # 32 apisix tools are in that state, and libFuzzer's cov: is flat by
        # construction because there is exactly one reachable path.
        # "Ran and found nothing" and "never actually ran" must not look alike.
        self.exec_success = 0
        self.exec_error_counts = {}
        self.start_fuzz_time = None

        # Instantiated helpers
        self.file_manager = FuzzFileManager(self.file_backed_params)
        self.input_parser = None

        # Metrics collection
        if getattr(self.config, "enable_metrics", True):
            self.metrics_collector = CoverageTimelineCollector(
                output_dir=getattr(self.config, "metrics_dir", "metrics"),
                export_csv=getattr(self.config, "export_csv", True),
                export_mongo=getattr(self.config, "export_mongo", False),
                sample_interval_sec=getattr(self.config, "metrics_sample_interval_sec", 60.0)
            )
        else:
            self.metrics_collector = None

    def _default_runner_factory(self, tool: str) -> BaseRunner:
        is_js = (
            any(arg.endswith(".js") for arg in self.args) or 
            any(js_cmd in self.command for js_cmd in ("node", "npx", "npm", "yarn", "pnpm"))
        )
        if is_js:
            from .runners import JSRunner
            return JSRunner(self.command, self.args, tool)
        else:
            from .runners import PythonRunner
            return PythonRunner(self.command, self.args, tool)

    def test_one_input(self, data: bytes) -> None:
        """The callback executed by Atheris for each input permutation."""
        if self.current_runner is None or self.current_schema is None:
            return

        self.exec_count += 1
        if self.start_fuzz_time is None:
            self.start_fuzz_time = time.time()
        if self.metrics_collector:
            self.metrics_collector.record_execution_progress(self.exec_count)

        # 1. Check if sequence mode is enabled (e.g. data length > 128 or config sequence_steps > 1)
        sequence_steps = getattr(self.config, "sequence_steps", 2) if hasattr(self, "config") else 1
        
        # Split data if sequence mode is active
        data_chunks = [data[i:i+len(data)//sequence_steps] for i in range(0, len(data), max(1, len(data)//sequence_steps))] if sequence_steps > 1 else [data]

        for step_idx, chunk in enumerate(data_chunks):
            # 1. Parse Input using delegated parser helper
            generated_arguments, parsed_successfully = self.input_parser.parse(chunk)

            # 2. Prepare File-Backed Parameters using delegated file manager helper
            generated_arguments, created_temp_files = self.file_manager.prepare_file_params(generated_arguments)

            # 3. Execute and Measure
            res, elapsed, leaked_files, leaked_pids = self._execute_and_time(generated_arguments, created_temp_files)

            if getattr(res, "success", False):
                self.exec_success += 1
            else:  # noqa: E501
                # Bucket by the error's shape, not its full text, so one
                # recurring cause does not become thousands of distinct keys.
                key = (str(getattr(res, "error", "") or "unknown"))[:120]
                self.exec_error_counts[key] = self.exec_error_counts.get(key, 0) + 1

            # EMIT PERIODICALLY, NOT AT THE END. libFuzzer terminates the
            # process itself when -max_total_time expires, so everything after
            # engine.fuzz() is dead code: "[FUZZING METRICS]" and "Fuzzing
            # session completed" appear in ZERO of the logs this repo has ever
            # produced, and libFuzzer's own closing "Done ... runs" line is lost
            # with them (the stderr reader is a daemon thread and the pipe is
            # not drained on a hard exit). A summary that only prints at the end
            # is a summary that never prints. run_eval takes the LAST one.
            if self.exec_count == 1 or self.exec_count % 512 == 0:
                self._emit_exec_summary()

            # 4. Run Sanitizers
            sanitizer_triggered, triggered_by, err_details = self._run_sanitizers(
                generated_arguments, res, elapsed, leaked_files, leaked_pids
            )

            # 5. Handle Violations
            if sanitizer_triggered:
                self._handle_violation(generated_arguments, res.result if hasattr(res, 'result') else res, triggered_by, f"[Sequence Step {step_idx+1}/{len(data_chunks)}] {err_details}")
                break


    def _emit_exec_summary(self) -> None:
        """One greppable line per tool. eval/run_eval.py parses the LAST one."""
        rate = (self.exec_success / self.exec_count) if self.exec_count else 0.0
        logger.info(f"EXEC_SUMMARY tool={self.target_tool_name} n_exec={self.exec_count} "
                    f"n_success={self.exec_success} success_rate={rate:.3f}")
        for err, n in sorted(self.exec_error_counts.items(), key=lambda kv: -kv[1])[:3]:
            logger.info(f"EXEC_ERROR n={n} detail={err!r}")
        if self.exec_count >= 64 and self.exec_success == 0:
            logger.error(
                f"NOT_EXECUTABLE tool={self.target_tool_name} -- all {self.exec_count} "
                f"executions returned an error, so NO sanitizer could fire and coverage "
                f"cannot vary. This run is NOT evidence that the tool is clean. Most "
                f"common cause: the tool is a client for a backend/credential that is "
                f"not present in this environment.")

    def _handle_violation(self, inputs: dict, result: any, triggered_by: list[str], err_details: str) -> None:
        """Logs the triggered security exception and marks bug found without stopping the session."""
        self.reporter.report(
            self.target_tool_name,
            inputs,
            result,
            triggered_by,
            err_details
        )
        self.silent_bug_found = True

    def _execute_and_time(self, generated_arguments: dict, created_temp_files: list[str]) -> tuple[any, float, set[str], set[int]]:
        """Executes the runner, measures duration, and detects leaked temporary files."""
        import tempfile as tf_mod
        temp_dir = tf_mod.gettempdir()
        try:
            before_files = set(glob.glob(os.path.join(temp_dir, "*")))
        except Exception:
            before_files = set()

        before_pids = set()
        ps_before = {}
        # Gate on EITHER consumer. _check_process_leak fires for
        # check_process_and_fd_leaks OR check_terminal_dos_and_leak, but the
        # snapshot was only taken for the latter -- and the former is one of the
        # 10 BASE_MANDATORY_SANITIZERS, i.e. always on. So a mandatory sanitizer
        # could never fire: leaked_pids was empty whenever the opt-in one was
        # not also selected.
        if _PROC_SANITIZERS & set(self.selected_sanitizer_names):
            ps_before = _ps_snapshot()
            before_pids = set(ps_before)
            if not ps_before and not getattr(self, "_ps_warned", False):
                self._ps_warned = True
                logger.error(
                    "check_terminal_dos_and_leak is selected but the process "
                    "snapshot is EMPTY, so process-leak detection cannot fire. "
                    "Do not read a clean run as evidence of no leak.")

        start_time = time.time()
        try:
            res = self.current_runner.execute(generated_arguments)
        finally:
            self.file_manager.clean_temp_files(created_temp_files)
        elapsed = time.time() - start_time

        try:
            after_files = set(glob.glob(os.path.join(temp_dir, "*")))
        except Exception:
            after_files = set()
        
        leaked_files = {f for f in (after_files - before_files) if not f.endswith((".cpuprofile", ".cpuprofile.json")) and "systemd-private-" not in f}

        after_pids = set()
        ps_after = {}
        if _PROC_SANITIZERS & set(self.selected_sanitizer_names):
            ps_after = _ps_snapshot()
            after_pids = set(ps_after)

        leaked_pids = after_pids - before_pids
        if leaked_pids and self.current_runner and self.current_runner.process:
            ancestor_pid = self.current_runner.process.pid
            filtered_leaked_pids = set()
            self._last_ps = ps_after
            for pid in leaked_pids:
                curr = pid
                is_child = False
                for _ in range(100):
                    if curr == ancestor_pid:
                        is_child = True
                        break
                    if curr <= 1:
                        break
                    parent = ps_after.get(curr)
                    if parent is None:
                        break
                    curr = parent[0]
                if is_child:
                    filtered_leaked_pids.add(pid)
            leaked_pids = filtered_leaked_pids

        return res, elapsed, leaked_files, leaked_pids

    def _run_sanitizers(self, generated_arguments: dict, res: any, elapsed: float, leaked_files: set[str], leaked_pids: set[int]) -> tuple[bool, list[str], str]:
        """Runs the fuzzer's active security sanitizers on input/execution details."""
        triggered_by = []
        err_details = ""

        # 1. Check temp file leaks
        leak_triggered, leak_err = self._check_temp_file_leak(leaked_files)
        if leak_triggered:
            triggered_by.append("check_temp_file_leak")
            err_details += leak_err

        # 2. Check process leaks / terminal DoS
        if "check_process_and_fd_leaks" in self.selected_sanitizer_names or "check_terminal_dos_and_leak" in self.selected_sanitizer_names:
            proc_leak_triggered, proc_leak_err = self._check_process_leak(leaked_pids)
            if proc_leak_triggered:
                triggered_by.append("check_process_and_fd_leaks")
                err_details += proc_leak_err

        # 3. Check resource exhaustion / timeout (e.g. ReDoS)
        timeout_triggered, timeout_err = self._check_resource_exhaustion(elapsed)
        if timeout_triggered:
            triggered_by.append("check_resource_exhaustion")
            err_details += timeout_err

        # 4. Check unexpected library/runtime crashes
        crash_triggered, crash_err = self._check_unexpected_crash(res)
        if crash_triggered:
            triggered_by.append("check_unexpected_crash")
            err_details += crash_err

        # 4.c Run Introspection Sanitizers: check file system accesses, deserialization, command execution, SQL queries, file uploads, code injection, SSRF, and temp leaks
        from .sanitizers import (
            check_unhandled_promise_rejection, check_file_access, check_introspection_path_traversal, 
            check_untrusted_deserialization, check_introspection_command_injection, check_introspection_sql_injection,
            check_unrestricted_file_upload, check_introspection_code_injection, check_introspection_ssrf,
            check_introspection_temp_file_leak, check_introspection_log_injection, check_introspection_sensitive_data_logging,
            check_introspection_ssl_verification, check_introspection_sensitive_file_access,
            check_introspection_unrestricted_ip_binding, check_introspection_redos,
            check_introspection_blocking_event_loop_call, check_introspection_hardcoded_credentials,
            check_introspection_weak_hash, check_introspection_weak_prng, check_introspection_nonce_reuse,
            check_introspection_unverified_code_download, check_introspection_xxe, check_introspection_data_amplification,
            check_introspection_argument_injection, check_introspection_csv_formula_injection,
            check_introspection_symlink_following, check_introspection_insecure_temp_permissions,
            check_introspection_sensitive_error_leak, check_introspection_reachable_assertion,
            check_introspection_cleartext_sensitive_storage, check_introspection_cleartext_sensitive_transmission,
            check_introspection_failed_init_non_exit, check_introspection_incomplete_cleanup,
            check_introspection_unchecked_loop_condition, check_introspection_memory_access_violation,
            check_introspection_divide_by_zero, check_introspection_insecure_file_permissions,
            check_introspection_deadlock, check_introspection_file_descriptor_leak,
            check_introspection_prototype_pollution, check_introspection_external_config_control,
            check_introspection_format_string, check_introspection_type_confusion,
            check_introspection_cross_session_data_leak, check_introspection_unnecessary_root_privileges
        )
        if "check_unhandled_promise_rejection" in self.selected_sanitizer_names:
            unhandled_triggered, unhandled_err = check_unhandled_promise_rejection(res.result if hasattr(res, 'result') else res)
            if unhandled_triggered:
                triggered_by.append("check_unhandled_promise_rejection")
                err_details += unhandled_err

        prev_session_data = getattr(res, "prev_session_data", "")
        current_out = str(getattr(res, "result", ""))
        if "check_introspection_cross_session_data_leak" in self.selected_sanitizer_names or (prev_session_data and current_out):
            cs_triggered, cs_err = check_introspection_cross_session_data_leak(prev_session_data, current_out)
            if cs_triggered:
                triggered_by.append("check_introspection_cross_session_data_leak")
                err_details += cs_err

        error_string = str(getattr(res, "error", ""))
        if "check_introspection_type_confusion" in self.selected_sanitizer_names or error_string:
            tc_triggered, tc_err = check_introspection_type_confusion(error_string)
            if tc_triggered:
                triggered_by.append("check_introspection_type_confusion")
                err_details += tc_err

        error_string = str(getattr(res, "error", ""))
        logs_list = getattr(res, "logs", [])
        if "check_introspection_format_string" in self.selected_sanitizer_names or error_string or logs_list:
            fmt_triggered, fmt_err = check_introspection_format_string(error_string, logs_list)
            if fmt_triggered:
                triggered_by.append("check_introspection_format_string")
                err_details += fmt_err

        mod_env = getattr(res, "modified_env_vars", [])
        if "check_introspection_external_config_control" in self.selected_sanitizer_names or mod_env:
            env_triggered, env_err = check_introspection_external_config_control(mod_env)
            if env_triggered:
                triggered_by.append("check_introspection_external_config_control")
                err_details += env_err

        # Check prototype pollution in test input / payload
        input_args = getattr(res, "input_args", None)
        if "check_introspection_prototype_pollution" in self.selected_sanitizer_names or input_args:
            proto_triggered, proto_err = check_introspection_prototype_pollution(input_args)
            if proto_triggered:
                triggered_by.append("check_introspection_prototype_pollution")
                err_details += proto_err

        leaked_fds = getattr(res, "leaked_fds", [])
        if "check_introspection_file_descriptor_leak" in self.selected_sanitizer_names or leaked_fds:
            fd_triggered, fd_err = check_introspection_file_descriptor_leak(len(leaked_fds), leaked_fds)
            if fd_triggered:
                triggered_by.append("check_introspection_file_descriptor_leak")
                err_details += fd_err

        is_timeout = getattr(res, "timed_out", False)
        active_locks = getattr(res, "active_locks_count", 0)
        if "check_introspection_deadlock" in self.selected_sanitizer_names or is_timeout:
            dead_triggered, dead_err = check_introspection_deadlock(is_timeout, active_locks)
            if dead_triggered:
                triggered_by.append("check_introspection_deadlock")
                err_details += dead_err

        exit_code = getattr(res, "exit_code", 0)
        error_string = str(getattr(res, "error", ""))
        if "check_introspection_divide_by_zero" in self.selected_sanitizer_names or error_string:
            div_triggered, div_err = check_introspection_divide_by_zero(error_string)
            if div_triggered:
                triggered_by.append("check_introspection_divide_by_zero")
                err_details += div_err

        if "check_introspection_memory_access_violation" in self.selected_sanitizer_names or exit_code or error_string:
            mem_triggered, mem_err = check_introspection_memory_access_violation(exit_code, error_string)
            if mem_triggered:
                triggered_by.append("check_introspection_memory_access_violation")
                err_details += mem_err

        loop_count = getattr(res, "loop_iterations", 0)
        if "check_introspection_unchecked_loop_condition" in self.selected_sanitizer_names or loop_count:
            loop_triggered, loop_err = check_introspection_unchecked_loop_condition(loop_count)
            if loop_triggered:
                triggered_by.append("check_introspection_unchecked_loop_condition")
                err_details += loop_err

        logged_msgs = getattr(res, "logged_messages", [])
        is_success = getattr(res, "success", True)
        if "check_introspection_failed_init_non_exit" in self.selected_sanitizer_names or logged_msgs:
            init_triggered, init_err = check_introspection_failed_init_non_exit(is_success, logged_msgs)
            if init_triggered:
                triggered_by.append("check_introspection_failed_init_non_exit")
                err_details += init_err

        leaked_temps = getattr(res, "leaked_temp_files", [])
        if "check_introspection_incomplete_cleanup" in self.selected_sanitizer_names or leaked_temps:
            clean_triggered, clean_err = check_introspection_incomplete_cleanup(leaked_temps)
            if clean_triggered:
                triggered_by.append("check_introspection_incomplete_cleanup")
                err_details += clean_err

        net_conns = getattr(res, "network_connections", [])
        if "check_introspection_cleartext_sensitive_transmission" in self.selected_sanitizer_names or net_conns:
            trans_triggered, trans_err = check_introspection_cleartext_sensitive_transmission(net_conns)
            if trans_triggered:
                triggered_by.append("check_introspection_cleartext_sensitive_transmission")
                err_details += trans_err

        # Check errors / stack traces for sensitive disclosures (CWE-209) and reachable assertion DoS (CWE-617)
        error_string = str(getattr(res, "error", ""))
        if "check_introspection_sensitive_error_leak" in self.selected_sanitizer_names or error_string:
            leak_triggered, leak_err = check_introspection_sensitive_error_leak(error_string)
            if leak_triggered:
                triggered_by.append("check_introspection_sensitive_error_leak")
                err_details += leak_err

        if "check_introspection_reachable_assertion" in self.selected_sanitizer_names or error_string:
            assert_triggered, assert_err = check_introspection_reachable_assertion(error_string)
            if assert_triggered:
                triggered_by.append("check_introspection_reachable_assertion")
                err_details += assert_err

        accessed_files = getattr(res, "accessed_files", [])
        if "check_introspection_symlink_following" in self.selected_sanitizer_names or accessed_files:
            sym_triggered, sym_err = check_introspection_symlink_following(accessed_files)
            if sym_triggered:
                triggered_by.append("check_introspection_symlink_following")
                err_details += sym_err

        written_files = getattr(res, "written_files", [])
        if "check_introspection_insecure_file_permissions" in self.selected_sanitizer_names or written_files:
            file_perm_triggered, file_perm_err = check_introspection_insecure_file_permissions(written_files)
            if file_perm_triggered:
                triggered_by.append("check_introspection_insecure_file_permissions")
                err_details += file_perm_err

        if "check_introspection_cleartext_sensitive_storage" in self.selected_sanitizer_names or written_files:
            store_triggered, store_err = check_introspection_cleartext_sensitive_storage(written_files)
            if store_triggered:
                triggered_by.append("check_introspection_cleartext_sensitive_storage")
                err_details += store_err

        if "check_introspection_insecure_temp_permissions" in self.selected_sanitizer_names or written_files:
            perm_triggered, perm_err = check_introspection_insecure_temp_permissions(written_files)
            if perm_triggered:
                triggered_by.append("check_introspection_insecure_temp_permissions")
                err_details += perm_err

        if "check_introspection_csv_formula_injection" in self.selected_sanitizer_names or written_files:
            csv_triggered, csv_err = check_introspection_csv_formula_injection(written_files)
            if csv_triggered:
                triggered_by.append("check_introspection_csv_formula_injection")
                err_details += csv_err

        executed_cmds = getattr(res, "executed_commands", [])
        if "check_introspection_unnecessary_root_privileges" in self.selected_sanitizer_names or executed_cmds:
